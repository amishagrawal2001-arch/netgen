include requirements.txt
include README.md
include INSTALLATION.md
include install_docker.sh
include install_ostg_complete.py
include Dockerfile.frr
include start-frr.sh
include frr.conf.template
include systemd/*.service
include systemd/*.timer

# Exclude backup folder and temporary files
exclude backup/
exclude backup/**
exclude *.backup.*
exclude *.tmp
exclude *.temp

# DPDK tx_worker: ship the source (tx_worker.c + meson.build) only.
# install_dpdk.sh step 6 rebuilds the binary against the host's DPDK,
# so the build/ tree from any dev machine is stale by definition and
# would mislead anyone who tries to run it directly.
recursive-exclude resources/dpdk/tx_worker/build *
prune resources/dpdk/tx_worker/build
