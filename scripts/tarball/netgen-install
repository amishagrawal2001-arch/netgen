#!/usr/bin/env python3
"""netgen-install — set up a netgen-server install from the tarball.

Run as root from inside the extracted tarball:
  sudo /opt/netgen-server/bin/netgen-install

Or from anywhere if the tarball is extracted to /opt/netgen-server:
  sudo netgen-install   (after PATH symlink is created — step 8 below)

What this script does, in order:

  1. Verify it's running as root (everything below needs it).
  2. Pre-flight checks. Refuse to install on unsupported OS, surface
     concrete remediation for fixable failures (low disk, no Docker,
     etc.). Each check has a clear-error message — no mystery
     failures deep in the install.
  3. Resolve the install root. The tarball MUST be extracted to a
     final-home location BEFORE this script runs; we don't move
     ourselves around. /opt/netgen-server is the canonical home.
  4. Build the FRR Docker image (existing Dockerfile.frr in share/).
     Skipped with a WARNING if Docker isn't usable — netgen still
     starts without it; only the DHCP / FRR features are disabled.
  5. (Optional) Compile DPDK tx_worker against the host's libdpdk.
     Skipped if DPDK prereqs aren't met (libdpdk-dev, meson, ninja,
     etc.) — DPDK falls back to Scapy/kernel path at runtime.
  6. Write /etc/systemd/system/netgen-server.service. The ExecStart
     points directly at <install_root>/netgen-venv/bin/ostg-server,
     so the unit is decoupled from anything system-pip ever did.
     If a pre-v0.5.0 unit exists at this path, save it as .bak.
  7. systemctl daemon-reload, enable, start.
  8. Create /usr/local/bin/netgen-install / netgen-upgrade /
     netgen-uninstall symlinks pointing into <install_root>/bin/
     so operators can run them without typing the full path.
  9. Verify /api/health responds with the expected version.

What this script DOES NOT do (intentionally):

  * Install system packages via apt. The tarball's bundled Python +
    pre-built venv eliminates the Python-side apt dependency. The
    only system tool we need that ISN'T bundled is Docker — and
    Docker is detected, not installed. If it's missing, we direct
    the operator to Docker's official install docs.
  * Install Python 3.10 from deadsnakes. Bundled.
  * Run `pip install` against system pip. Bundled venv has its own
    pip; only used by netgen-upgrade.
  * Touch PEP 668. The bundled venv is exempt from EXTERNALLY-
    MANAGED by design.

  All the failure modes from v0.4.7 / v0.4.8 / v0.4.9 (netcat
  virtual package, deps install silent no-op, PEP 668) are
  eliminated by this script being a thin install wrapper around
  the bundled venv, not a system-environment rebuilder.

Idempotency: re-running this script on an existing v0.5.0 install
is safe — it stops the service, re-writes the unit, restarts.
The bundled venv stays intact (it was already correct).
"""
from __future__ import annotations

import logging
import os
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
from pathlib import Path
from typing import Optional

# ─────────────────────────────────────────────────── constants

INSTALL_ROOT_DEFAULT = Path("/opt/netgen-server")
SYSTEMD_UNIT_PATH = Path("/etc/systemd/system/netgen-server.service")
SYSTEMD_UNIT_NAME = "netgen-server.service"  # matches v0.4.x for upgrade compat
SERVER_PORT = 5050  # legacy convention; do not change without a migration plan
LOG_PATH = Path("/var/log/netgen-install.log")

# Supported OS matrix. The pre-flight gate refuses unsupported
# distros with a clear remediation — operator can override with
# --force, but they own the outcome at that point.
SUPPORTED_DISTROS = {
    ("ubuntu", "22.04"),
    ("ubuntu", "24.04"),
}


# ─────────────────────────────────────────────────── logging

logger = logging.getLogger("netgen-install")


def _setup_logging() -> None:
    """Mirror logs to both stdout AND /var/log/netgen-install.log so
    operators can read along live AND we have a postmortem record."""
    logger.setLevel(logging.INFO)
    fmt = logging.Formatter("[%(levelname)s] %(message)s")
    # stdout
    sh = logging.StreamHandler(sys.stdout)
    sh.setFormatter(fmt)
    logger.addHandler(sh)
    # file
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        fh = logging.FileHandler(LOG_PATH, mode="w")
        fh.setFormatter(logging.Formatter(
            "%(asctime)s [%(levelname)s] %(message)s"
        ))
        logger.addHandler(fh)
    except Exception as exc:
        # File-log failure is non-fatal — we still have stdout.
        logger.warning(f"Could not open log file {LOG_PATH}: {exc}")


# ─────────────────────────────────────────────────── helpers


def _run(cmd: list[str], *, check: bool = True,
         capture: bool = False) -> subprocess.CompletedProcess:
    """Thin wrapper that logs the command before running. Lets the
    operator see what's about to happen instead of mysterious
    silence."""
    logger.info(f"$ {' '.join(cmd)}")
    return subprocess.run(
        cmd,
        check=check,
        capture_output=capture,
        text=capture,
    )


def _require_root() -> None:
    if os.geteuid() != 0:
        logger.error(
            "netgen-install must run as root. "
            "Retry with: sudo netgen-install"
        )
        sys.exit(1)


def _detect_distro() -> tuple[str, str]:
    """Parse /etc/os-release. Returns (id, version_id) lowercased.
    Returns (\"unknown\", \"\") if /etc/os-release is missing or
    malformed."""
    try:
        kv = {}
        for line in Path("/etc/os-release").read_text().splitlines():
            if "=" in line:
                k, _, v = line.partition("=")
                kv[k.strip()] = v.strip().strip('"').strip("'")
        return (kv.get("ID", "unknown").lower(),
                kv.get("VERSION_ID", "").strip())
    except Exception:
        return ("unknown", "")


def _resolve_install_root(argv: list[str]) -> Path:
    """Install root is either --install-root <path> or this
    script's parent's parent (e.g. /opt/netgen-server/bin/netgen-install
    → /opt/netgen-server)."""
    if "--install-root" in argv:
        i = argv.index("--install-root")
        if i + 1 < len(argv):
            return Path(argv[i + 1]).resolve()
    # __file__ is .../bin/netgen-install; parent.parent is the root.
    return Path(__file__).resolve().parent.parent


# ─────────────────────────────────────────────────── pre-flight


def _preflight(install_root: Path, *, force: bool) -> None:
    """Refuse to install if a hard prereq is missing. Each check
    has a CONCRETE remediation message — never a generic "something
    is wrong"."""
    logger.info("[PRE-FLIGHT] Checking environment...")

    # 0. v0.5.256: warn if the operator extracted to a non-canonical
    #    location. The v0.5.256 shim-polyglot fix (see build-server-
    #    tarball.yml step 5) means bin/netgen-install now runs from
    #    ANY extract path — but the systemd unit + PATH symlinks +
    #    tarball README all assume /opt/netgen-server. Running from
    #    elsewhere works but produces a systemd unit that references
    #    a probably-temporary path (breaks on reboot / /tmp cleanup).
    canonical = Path(INSTALL_ROOT_DEFAULT)
    if install_root.resolve() != canonical.resolve():
        logger.warning(
            f"  - Install root {install_root} is NOT the documented "
            f"canonical location {canonical}."
        )
        logger.warning(
            f"    The systemd unit will hard-code ExecStart=."
            f"{install_root}/netgen-venv/bin/ostg-server — if you "
            f"extracted to /tmp or another impermanent path, the "
            f"unit will break on reboot / cleanup."
        )
        logger.warning(
            f"    Recommended: `sudo mv {install_root} {canonical} "
            f"&& sudo {canonical}/bin/netgen-install`"
        )
        if not force:
            logger.error(
                f"    Refusing to install from a non-canonical "
                f"location. Override with --force if you really mean "
                f"it and understand the systemd unit ties to this path."
            )
            sys.exit(8)

    # 1. OS supported?
    distro, version = _detect_distro()
    logger.info(f"  - OS: {distro} {version}")
    if (distro, version) not in SUPPORTED_DISTROS and not force:
        logger.error(
            f"Unsupported OS: {distro} {version}. Supported: "
            f"{', '.join(f'{d} {v}' for d, v in sorted(SUPPORTED_DISTROS))}."
        )
        logger.error(
            "Override with --force-install-unsupported (no warranty)."
        )
        sys.exit(2)

    # 2. Tarball layout sanity. If the operator extracted incorrectly
    #    or pointed --install-root at the wrong place, fail HERE
    #    instead of getting cryptic ImportError later.
    required = [
        install_root / "python-runtime" / "bin" / "python3",
        install_root / "netgen-venv" / "bin" / "ostg-server",
        install_root / "share" / "netgen" / "resources" / "dpdk",
        install_root / "share" / "netgen" / "Dockerfile.frr",
    ]
    missing = [p for p in required if not p.exists()]
    if missing:
        logger.error(
            f"Install root {install_root} is missing expected files:"
        )
        for m in missing:
            logger.error(f"  - {m}")
        logger.error(
            "The tarball must be extracted intact to a single root. "
            "Did you extract it to a different path than the one passed "
            "to --install-root?"
        )
        sys.exit(3)
    logger.info(f"  - Tarball layout: ✓ ({install_root})")

    # 3. Disk space.
    try:
        st = shutil.disk_usage(install_root)
        free_gb = st.free / (1024 ** 3)
        logger.info(f"  - Disk free: {free_gb:.1f} GB")
        if free_gb < 1.0:
            logger.error(
                f"Less than 1 GB free on {install_root}. "
                f"systemd unit writes + log space need at least 1 GB."
            )
            sys.exit(4)
    except Exception as exc:
        logger.warning(f"  - Disk check failed: {exc}")

    # 4. systemd availability.
    if not Path("/run/systemd/system").exists():
        logger.error(
            "systemd not detected (no /run/systemd/system). This "
            "installer writes a systemd unit; without systemd you'd "
            "need to start ostg-server manually."
        )
        sys.exit(5)
    logger.info("  - systemd: ✓")

    # 5. Docker (warning only — netgen runs without it, just no FRR).
    docker_ok = shutil.which("docker") is not None
    if docker_ok:
        try:
            r = _run(["docker", "version", "--format", "{{.Server.Version}}"],
                     check=False, capture=True)
            if r.returncode == 0:
                logger.info(f"  - Docker: ✓ ({r.stdout.strip()})")
            else:
                logger.warning(
                    "  - Docker installed but daemon unreachable. "
                    "FRR / DHCP features will be disabled until the "
                    "Docker daemon is started: systemctl start docker"
                )
                docker_ok = False
        except Exception:
            docker_ok = False
    else:
        logger.warning(
            "  - Docker not found. FRR / DHCP features will be "
            "disabled. Install Docker via your distro's docs "
            "(https://docs.docker.com/engine/install/) and re-run "
            "netgen-install to enable them."
        )

    # 6. The bundled venv's Python must actually run.
    venv_py = install_root / "netgen-venv" / "bin" / "python"
    try:
        r = _run([str(venv_py), "--version"], check=True, capture=True)
        logger.info(f"  - Bundled Python: ✓ ({r.stdout.strip() or r.stderr.strip()})")
    except Exception as exc:
        logger.error(
            f"Bundled Python at {venv_py} failed to run: {exc}. "
            f"The tarball is corrupt or was extracted to a path with "
            f"a different layout."
        )
        sys.exit(6)

    # 7. Core deps importable from the bundled venv. Same check the
    #    v0.5.0 tarball build workflow does — but the operator might
    #    have extracted onto a system that lacks libpcap.so (Scapy
    #    runtime dep on Debian/Ubuntu), so we surface it HERE
    #    instead of letting the server crash-loop on it.
    try:
        _run(
            [str(venv_py), "-c",
             "import flask, scapy.all, requests, psutil"],
            check=True, capture=True,
        )
        logger.info("  - Core deps importable: ✓ (flask, scapy, requests, psutil)")
    except subprocess.CalledProcessError as exc:
        logger.error(
            f"Bundled venv can't import core dependencies. "
            f"Most likely cause: Scapy needs libpcap on the host. "
            f"Install with: apt install libpcap0.8\n"
            f"Underlying error:\n{exc.stderr or exc.stdout}"
        )
        sys.exit(7)

    return None  # all checks passed


# ─────────────────────────────────────────────────── FRR Docker

def _setup_lldpd() -> None:
    """v0.5.82: install + enable lldpd so the admin console can show
    LLDP neighbors per network interface.

    Operator-requested: 'enable lldp on the server and lldp package
    should be part of tar.gz fresh installer'.

    This is the only apt-based step in the installer. Justification:
    lldpd is a tiny package (~100 KB binary, single dependency
    libsnmp), it's universally available in apt for every Debian /
    Ubuntu release netgen supports, and the alternative (operator
    runs `apt install lldpd` separately, then `systemctl enable
    --now lldpd`, then edits `/etc/lldpd.d/` to enable on all NICs)
    is exactly the kind of multi-step shoulder-tap netgen-install
    exists to avoid.

    Best-effort: failure is logged + skipped (operator can install
    later) — does NOT abort the install. The admin console
    gracefully shows '(no LLDP)' per row when lldpcli isn't present.
    """
    logger.info("[LLDP] Installing lldpd + enabling system-wide LLDP discovery")

    # Install package (idempotent — apt skips if already present).
    apt_res = _run(
        ["apt-get", "install", "-y", "-o", "APT::Sandbox::User=root",
         "lldpd"],
        check=False, capture=True,
    )
    if apt_res.returncode != 0:
        logger.warning(
            f"[LLDP] apt-get install lldpd failed (rc={apt_res.returncode}). "
            f"Skipping LLDP setup — admin console will show '(no LLDP)' per "
            f"iface row. Manual install: `apt install lldpd && systemctl "
            f"enable --now lldpd`."
        )
        if apt_res.stderr:
            logger.warning(f"[LLDP] apt stderr: {apt_res.stderr.strip()[:500]}")
        return

    # Configure: receive AND send LLDP, advertise system info on all
    # interfaces. Default lldpd config is "receive only on most
    # boxes" — we want both directions so neighbor switches can also
    # see this host.
    conf_dir = Path("/etc/lldpd.d")
    try:
        conf_dir.mkdir(parents=True, exist_ok=True)
        conf_file = conf_dir / "netgen-server.conf"
        conf_file.write_text(
            "# Written by netgen-install — enables LLDP TX + RX on all\n"
            "# Ethernet ports. Operators on srv06+ asked for this so\n"
            "# the admin console can show neighbor switch info per port.\n"
            "configure system platform 'netgen-server'\n"
            "configure system description 'netgen traffic generator'\n"
            "configure lldp tx-interval 30\n"
            "configure lldp tx-hold 4\n"
        )
        logger.info(f"[LLDP] Wrote config: {conf_file}")
    except Exception as exc:
        logger.warning(f"[LLDP] Could not write {conf_dir}: {exc}")

    # Enable + start. Idempotent.
    _run(["systemctl", "enable", "--now", "lldpd"], check=False)
    res = _run(["systemctl", "is-active", "lldpd"],
               check=False, capture=True)
    if res.stdout and res.stdout.strip() == "active":
        logger.info("[LLDP] lldpd is active — admin console will show "
                    "neighbors as switches advertise.")
    else:
        logger.warning(
            "[LLDP] lldpd may not be running. Check: "
            "`systemctl status lldpd`."
        )


def _build_frr_image(install_root: Path) -> bool:
    """Build the netgen-frr:latest Docker image from Dockerfile.frr.
    Returns True on success, False on failure (logged but non-fatal —
    netgen still starts without FRR, just no DHCP/BGP/OSPF features).

    v0.5.11 fix: use ostg_docker/ as both -f source AND build context.
    The Dockerfile.frr's COPY directives reference sibling files
    (frr.conf.template, start-frr.sh). Those files live in
    share/netgen/ostg_docker/, NOT share/netgen/. Using share/netgen/
    as the build context (v0.5.10) made every COPY fail:

      [4/7] COPY frr.conf.template /etc/frr/frr.conf.template
      ERROR: failed to calculate checksum of ref ...:
        "/frr.conf.template": not found

    The v0.5.0+ workflow copied Dockerfile.frr to BOTH locations
    (share/netgen/ and share/netgen/ostg_docker/), but only
    ostg_docker/ has the template+script siblings. Use the subdir
    where everything coexists.
    """
    if shutil.which("docker") is None:
        logger.warning("[FRR] Docker not available — skipping FRR image build")
        return False
    logger.info("[FRR] Building netgen-frr:latest Docker image...")
    # Prefer ostg_docker/ subdir (has all 3 files). Fall back to
    # share/netgen/ for backward-compat with any imagined pre-v0.5.11
    # tarball that put everything at share/netgen/ root.
    ostg_docker = install_root / "share" / "netgen" / "ostg_docker"
    legacy_root = install_root / "share" / "netgen"
    if (ostg_docker / "Dockerfile.frr").exists() and \
            (ostg_docker / "frr.conf.template").exists() and \
            (ostg_docker / "start-frr.sh").exists():
        dockerfile = ostg_docker / "Dockerfile.frr"
        context = ostg_docker
        logger.info(f"[FRR]   context: {context} (v0.5.11 layout)")
    else:
        dockerfile = legacy_root / "Dockerfile.frr"
        context = legacy_root
        logger.warning(
            f"[FRR]   context: {context} (legacy layout — pre-v0.5.11; "
            f"sibling files might be missing)"
        )
    try:
        _run(
            ["docker", "build",
             "-f", str(dockerfile),
             "-t", "netgen-frr:latest",
             str(context)],
            check=True,
        )
        # v0.5.13: also tag as ostg-frr:latest for legacy code paths.
        # utils/frr_vrf.py:32 falls back to "ostg-frr:latest" when
        # _resolve_frr_image() throws — a defensive fallback that
        # otherwise dangles since netgen-install previously only
        # tagged the new name. utils/frr_docker.py adds the same dual
        # tag (line 183), but only when it builds via the lazy self-
        # heal path. Mirror it here so installs that never trigger
        # the lazy build still have the legacy tag available.
        try:
            _run(
                ["docker", "tag", "netgen-frr:latest", "ostg-frr:latest"],
                check=False,
            )
        except Exception as e:
            logger.debug(f"[FRR] legacy ostg-frr tag failed (non-fatal): {e}")
        logger.info("[FRR] ✓ Image built (tagged netgen-frr:latest + ostg-frr:latest)")
        return True
    except subprocess.CalledProcessError as exc:
        logger.warning(
            f"[FRR] Docker build failed: {exc}. FRR-dependent features "
            f"(DHCP / BGP / OSPF / VXLAN device side) will be disabled. "
            f"Re-run netgen-install after fixing Docker to enable them."
        )
        return False


# ─────────────────────────────────────────────────── systemd unit


def _write_systemd_unit(install_root: Path) -> None:
    """Write /etc/systemd/system/netgen-server.service.

    Backs up an existing unit (v0.4.x install) to .bak so we don't
    silently overwrite an operator-edited unit."""
    exec_start = install_root / "netgen-venv" / "bin" / "ostg-server"
    unit = f"""[Unit]
Description=Netgen Traffic Generator Server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart={exec_start}
Restart=on-failure
RestartSec=10
# v0.5.56 (audit H8): expanded capability set so DPDK
# operations work in-process without the sudo + systemd-run
# gymnastics we accumulated in v0.5.31/33/44/50.
#   CAP_NET_RAW / CAP_NET_ADMIN — Scapy raw sockets + interface
#     management (original v0.5.0 set).
#   CAP_SYS_ADMIN — `mount -t hugetlbfs`, in-process writes to
#     /sys/.../nr_hugepages, write to /etc/default/grub-class
#     paths via systemd-run unit setup, etc.
#   CAP_SYS_MODULE — `modprobe vfio-pci` from in-process
#     subprocess. v0.5.44 wrapped this in systemd-run to escape
#     ProtectKernelModules; with this cap held, the wrap can be
#     skipped on non-hardened hosts.
#   CAP_SYS_BOOT — `systemctl reboot` from /api/dpdk/iommu
#     post-GRUB-edit flow.
#   CAP_SETUID / CAP_SETGID — sudo's setresuid() / setresgid()
#     pre-flight. v0.5.50 bypassed sudo when geteuid()==0 to
#     dodge the EPERM; keep the cap so sudo paths also work.
#   CAP_DAC_OVERRIDE / CAP_DAC_READ_SEARCH — read /etc/sudoers
#     (mode 0440), read sysfs files owned by root with 0600 perms.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_MODULE CAP_SYS_BOOT CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_MODULE CAP_SYS_BOOT CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
# Operator-bite caught on srv06 (Jun 11 2026): without these
# rlimits, Mellanox mlx5 PMD probe fails with
#   mlx5_net: ingress mlx5dv_dr_create_domain failed
#   mlx5_net: probe of PCI device 0000:2b:00.0 aborted —
#     Cannot allocate memory
# because the PMD needs to mlock NIC queue + flow-table memory
# and the default systemd locked-memory cap (~64 KiB) is way
# short. LimitMEMLOCK=infinity is the canonical Mellanox DPDK
# requirement; LimitNOFILE is bumped so per-queue fd counts
# don't hit EMFILE on high-queue NICs (Mellanox 200G can want
# 1k+ fds); LimitNPROC=infinity lets the multi-instance
# tx_worker fork its worker threads without nproc throttling.
LimitMEMLOCK=infinity
LimitNOFILE=1048576
LimitNPROC=infinity
# v0.5.0 install root — independent of system Python.
WorkingDirectory={install_root}
# Forward stdout/stderr to journalctl so `journalctl -u netgen-server`
# shows the server log inline with systemd events.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
"""
    if SYSTEMD_UNIT_PATH.exists():
        bak = SYSTEMD_UNIT_PATH.with_suffix(".service.bak")
        logger.info(f"[SYSTEMD] Backing up existing unit to {bak}")
        shutil.copy2(SYSTEMD_UNIT_PATH, bak)
    SYSTEMD_UNIT_PATH.write_text(unit)
    logger.info(f"[SYSTEMD] ✓ Wrote {SYSTEMD_UNIT_PATH}")

    _run(["systemctl", "daemon-reload"], check=True)
    _run(["systemctl", "enable", SYSTEMD_UNIT_NAME], check=True)
    # Use restart (not start) so a re-install on a live host
    # actually picks up the new unit. start would no-op if already
    # active.
    _run(["systemctl", "restart", SYSTEMD_UNIT_NAME], check=True)
    logger.info(f"[SYSTEMD] ✓ {SYSTEMD_UNIT_NAME} restarted")


# ─────────────────────────────────────────────────── PATH symlinks


def _create_path_symlinks(install_root: Path) -> None:
    """Create /usr/local/bin/netgen-{install,upgrade,uninstall}
    symlinks so the operator doesn't have to type the full
    /opt/netgen-server/bin/... path. Idempotent — replaces any
    existing symlink."""
    bin_dir = Path("/usr/local/bin")
    for name in ("netgen-install", "netgen-upgrade", "netgen-uninstall"):
        src = install_root / "bin" / name
        if not src.exists():
            logger.warning(f"[PATH] {src} doesn't exist; skipping symlink")
            continue
        dst = bin_dir / name
        if dst.exists() or dst.is_symlink():
            dst.unlink()
        dst.symlink_to(src)
        logger.info(f"[PATH] ✓ {dst} → {src}")


def _create_netgen_compat_symlink(install_root: Path) -> None:
    """v0.5.13: /opt/netgen → install_root (typically /opt/netgen-server).

    Runtime code in utils/device_database.py and run_tgen_server.py
    defaults to /opt/netgen/database.db and /opt/netgen/.netgen_ai_
    server_settings.env. With the v0.5.x tarball install at
    /opt/netgen-server/, those defaults point at a non-existent
    directory; sqlite open + env file write both fail.

    On srv06 the legacy /opt/OSTG/ existed so the fallback resolution
    worked, masking the bug. A fresh v0.5.x host with no legacy
    /opt/OSTG would crash on first DB op — latent since the rebrand.

    Same pattern as v0.5.10's /opt/OSTG symlink. Idempotent: leave
    a pre-existing real /opt/netgen directory alone with a warning.
    """
    legacy = Path("/opt/netgen")
    target = install_root  # /opt/netgen-server
    if legacy.is_symlink():
        cur = legacy.resolve()
        if cur == target.resolve():
            logger.info(f"[COMPAT] ✓ /opt/netgen → {target} (already correct)")
            return
        legacy.unlink()
    elif legacy.is_dir():
        logger.warning(
            f"[COMPAT] /opt/netgen exists as a real directory; not "
            f"replacing. Default DB/settings paths still point there "
            f"— make sure they're maintained, or move them under "
            f"{target} and `sudo rm -rf /opt/netgen && sudo ln -s "
            f"{target} /opt/netgen`."
        )
        return
    legacy.symlink_to(target)
    logger.info(f"[COMPAT] ✓ /opt/netgen → {target}")


def _create_ostg_compat_symlink(install_root: Path) -> None:
    """v0.5.10: install_root/share/netgen → /opt/OSTG compat symlink.

    The runtime code in run_tgen_server.py (and elsewhere) hardcodes
    paths under /opt/OSTG/resources/dpdk/... and /opt/OSTG/
    Dockerfile.frr — leftover from the pre-tarball, system-pip era
    when install_ostg_complete.py deployed everything to /opt/OSTG/.

    Without a compat symlink, an operator who fresh-installs from the
    v0.5.0+ tarball gets a working server EXCEPT every DPDK bind/
    unbind/start operation fails because the bind script
    /opt/OSTG/resources/dpdk/dpdk_bind.sh doesn't exist. The error
    surfaces only when the operator tries to USE DPDK, not at install.

    The right long-term fix is to rewrite the runtime to look at
    /opt/netgen-server/share/netgen/resources/dpdk/ etc. (tracked
    as a separate follow-up). For now: symlink
    /opt/OSTG → /opt/netgen-server/share/netgen so the existing
    paths resolve correctly with zero code changes elsewhere.

    Idempotent: if /opt/OSTG already exists as a real directory, we
    leave it alone (might be a parallel legacy install) and log a
    warning. If it's already the right symlink, no-op. Otherwise
    create it.
    """
    legacy = Path("/opt/OSTG")
    target = install_root / "share" / "netgen"
    if legacy.is_symlink():
        cur = legacy.resolve()
        if cur == target.resolve():
            logger.info(f"[COMPAT] ✓ /opt/OSTG → {target} (already correct)")
            return
        legacy.unlink()
    elif legacy.is_dir():
        logger.warning(
            f"[COMPAT] /opt/OSTG exists as a real directory; not "
            f"replacing. DPDK runtime calls will use the legacy "
            f"path. To finish migration: `sudo rm -rf /opt/OSTG && "
            f"sudo ln -s {target} /opt/OSTG`."
        )
        return
    legacy.symlink_to(target)
    logger.info(f"[COMPAT] ✓ /opt/OSTG → {target}")


# ─────────────────────────────────────────────────── health check


def _verify_running(timeout_s: int = 60) -> bool:
    """Hit http://localhost:5050/api/health and parse the version.
    Wait up to timeout_s for systemd to have brought the server up
    (the unit `Restart=on-failure` could be retrying after a slow
    start)."""
    url = f"http://localhost:{SERVER_PORT}/api/health"
    deadline = time.monotonic() + timeout_s
    logger.info(f"[VERIFY] Waiting for {url} (up to {timeout_s}s)...")
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as r:
                body = r.read().decode("utf-8", "replace")
                if "netgen_version" in body:
                    logger.info(f"[VERIFY] ✓ Server responding: {body.strip()}")
                    return True
        except Exception:
            pass
        time.sleep(2)
    logger.error(
        f"[VERIFY] Server did not respond on {url} within {timeout_s}s."
    )
    # v0.5.11: dump diagnostics RIGHT HERE so operators see the cause
    # in the install log without a second ssh round-trip. The likely
    # culprits on a v0.4.x → v0.5.x migration:
    #   - legacy ostg-server.service still bound to :5050
    #   - bundled Python import failure (Flask app couldn't construct)
    #   - port 5050 held by something else (rare)
    logger.error("[VERIFY] Diagnostic dump follows ──")
    try:
        # 30 lines of recent journal output from the unit.
        _run(
            ["journalctl", "-u", SYSTEMD_UNIT_NAME,
             "-n", "30", "--no-pager"],
            check=False,
        )
    except Exception as e:
        logger.error(f"[VERIFY] journalctl failed: {e}")
    # Who's holding port 5050? Often the missing puzzle piece.
    try:
        _run(
            ["ss", "-tlnp", "sport", "=", ":5050"],
            check=False,
        )
    except Exception:
        # ss may not be available on every distro; fall back to lsof.
        try:
            _run(["lsof", "-i", ":5050"], check=False)
        except Exception:
            pass
    # Legacy v0.4.x service was named ostg-server.service. If it
    # exists and is still active, it's almost certainly the blocker.
    try:
        _run(
            ["systemctl", "is-active", "ostg-server.service"],
            check=False,
        )
    except Exception:
        pass
    logger.error("[VERIFY] ── end diagnostic dump")
    logger.error(
        f"[VERIFY] If 'ostg-server.service' is active above, run: "
        f"sudo systemctl disable --now ostg-server.service && "
        f"sudo systemctl restart {SYSTEMD_UNIT_NAME}"
    )
    return False


# ─────────────────────────────────────────────────── main


def main() -> int:
    _setup_logging()
    _require_root()

    argv = sys.argv[1:]
    force = "--force-install-unsupported" in argv or "--force" in argv

    install_root = _resolve_install_root(argv)
    logger.info(f"[STARTUP] Install root: {install_root}")
    logger.info(f"[STARTUP] Log file: {LOG_PATH}")

    _preflight(install_root, force=force)
    _setup_lldpd()  # v0.5.82: install + enable lldpd for neighbor discovery
    _build_frr_image(install_root)
    _write_systemd_unit(install_root)
    _create_path_symlinks(install_root)
    _create_ostg_compat_symlink(install_root)
    _create_netgen_compat_symlink(install_root)

    if _verify_running():
        logger.info("=" * 60)
        logger.info("netgen-server installation complete.")
        logger.info("=" * 60)
        logger.info(f"  Status: systemctl status {SYSTEMD_UNIT_NAME}")
        logger.info(f"  Logs:   journalctl -u {SYSTEMD_UNIT_NAME} -f")
        logger.info(f"  API:    http://<host>:{SERVER_PORT}/api/health")
        logger.info("")
        logger.info("To upgrade later (wheel-based, no full reinstall):")
        logger.info("  sudo netgen-upgrade /path/to/ostg_trafficgen-*.whl")
        return 0
    else:
        return 1


if __name__ == "__main__":
    sys.exit(main())
