#!/usr/bin/env python3
"""netgen-upgrade — install a new wheel into the bundled venv.

The wheel-based routine-upgrade path. Operator-stated requirement
(v0.5.0 design decision):

  tarball = fresh install / major version bump
  wheel   = routine patch & minor upgrades  ← this script

Usage:
  sudo netgen-upgrade /path/to/ostg_trafficgen-0.5.1-py3-none-any.whl

What this script does:

  1. Verify root.
  2. Verify the wheel path exists and is readable.
  3. Detect the install root (parent.parent of this script, just
     like netgen-install).
  4. pip install --upgrade --force-reinstall <wheel> INSIDE the
     bundled venv. --force-reinstall preserves the v0.4.8 lesson:
     pip must not silently no-op when it thinks the version matches.
  5. Verify the new version's deps still import (in case the wheel
     pulled in new mandatory deps the bundled venv doesn't have).
  6. systemctl restart netgen-server so the new code loads.
  7. Verify /api/health responds with the expected new version.

Why this is dramatically simpler than netgen-install:

  - No system pip touched. The bundled venv has its own pip.
  - No PEP 668 / EXTERNALLY-MANAGED to escape.
  - No Docker build, no systemd unit changes, no PATH symlinks.
  - The systemd unit's ExecStart still points at the same path
    (<install_root>/netgen-venv/bin/ostg-server); pip replacing the
    underlying script is transparent to systemd.

This script is intentionally KEPT SHORT — most operator upgrades
should take <30 seconds vs the multi-minute fresh install.
"""
from __future__ import annotations

import logging
import os
import subprocess
import sys
import time
import urllib.request
from pathlib import Path


SYSTEMD_UNIT_NAME = "netgen-server.service"
SERVER_PORT = 5050


logger = logging.getLogger("netgen-upgrade")


def _setup_logging() -> None:
    logger.setLevel(logging.INFO)
    sh = logging.StreamHandler(sys.stdout)
    sh.setFormatter(logging.Formatter("[%(levelname)s] %(message)s"))
    logger.addHandler(sh)


def _run(cmd: list[str], *, check: bool = True,
         capture: bool = False) -> subprocess.CompletedProcess:
    logger.info(f"$ {' '.join(cmd)}")
    return subprocess.run(cmd, check=check, capture_output=capture, text=capture)


def _require_root() -> None:
    if os.geteuid() != 0:
        logger.error("netgen-upgrade must run as root. Retry with: sudo netgen-upgrade <wheel>")
        sys.exit(1)


def _resolve_install_root(argv: list[str]) -> Path:
    if "--install-root" in argv:
        i = argv.index("--install-root")
        if i + 1 < len(argv):
            return Path(argv[i + 1]).resolve()
    # __file__ is .../bin/netgen-upgrade; parent.parent is the root.
    return Path(__file__).resolve().parent.parent


def _verify_new_version(timeout_s: int = 30) -> bool:
    """Confirm the server came back up post-restart."""
    url = f"http://localhost:{SERVER_PORT}/api/health"
    deadline = time.monotonic() + timeout_s
    logger.info(f"[VERIFY] Waiting for {url}...")
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as r:
                body = r.read().decode("utf-8", "replace")
                if "netgen_version" in body:
                    logger.info(f"[VERIFY] ✓ Server back up: {body.strip()}")
                    return True
        except Exception:
            pass
        time.sleep(2)
    logger.error(
        f"[VERIFY] Server did not respond on {url} within {timeout_s}s. "
        f"Check: journalctl -u {SYSTEMD_UNIT_NAME} -n 50 --no-pager"
    )
    return False


def _maybe_self_update_and_reexec(wheel: Path, argv: list[str]) -> None:
    """If the wheel's bundled netgen-upgrade differs from this
    running script, overwrite this script with the bundled copy
    and re-exec so the new logic takes effect immediately.

    Re-exec passes ``--no-self-update`` to prevent infinite
    self-update loops in the unlikely case the wheel's copy
    still differs after a write (it shouldn't).
    """
    import zipfile

    self_path = Path(__file__).resolve()
    try:
        with zipfile.ZipFile(str(wheel)) as zf:
            # The wheel bundles netgen-upgrade at
            # resources/tarball/netgen-upgrade (pyproject.toml
            # package-data declaration).
            wheel_names = [
                n for n in zf.namelist()
                if n.endswith("/resources/tarball/netgen-upgrade")
                or n.endswith("resources/tarball/netgen-upgrade")
            ]
            if not wheel_names:
                logger.info(
                    "[SELF-UPDATE] wheel doesn't bundle "
                    "netgen-upgrade; running with current version"
                )
                return
            new_bytes = zf.read(wheel_names[0])
    except Exception as exc:
        logger.warning(
            f"[SELF-UPDATE] could not read netgen-upgrade from "
            f"wheel: {exc}. Running with current version."
        )
        return

    try:
        current_bytes = self_path.read_bytes()
    except Exception as exc:
        logger.warning(
            f"[SELF-UPDATE] could not read self at {self_path}: "
            f"{exc}. Running with current version."
        )
        return

    if new_bytes == current_bytes:
        logger.info(
            "[SELF-UPDATE] ✓ wheel's netgen-upgrade matches "
            "running version; no self-update needed"
        )
        return

    logger.info(
        f"[SELF-UPDATE] wheel's netgen-upgrade differs from "
        f"{self_path}; updating and re-executing"
    )
    try:
        # Atomic-ish: write to .new, rename over.
        new_path = self_path.with_suffix(".new")
        new_path.write_bytes(new_bytes)
        new_path.chmod(0o755)
        new_path.replace(self_path)
    except Exception as exc:
        logger.warning(
            f"[SELF-UPDATE] write failed: {exc}. Running with "
            f"current (stale) version."
        )
        return

    # Re-exec with --no-self-update so we don't recurse.
    new_argv = [str(self_path)] + argv + ["--no-self-update"]
    logger.info(f"[SELF-UPDATE] re-exec: {' '.join(new_argv)}")
    os.execv(str(self_path), new_argv)


RLIMITS_DROPIN_PATH = Path(
    "/etc/systemd/system/netgen-server.service.d/10-netgen-rlimits.conf"
)
RLIMITS_DROPIN_CONTENT = """# Managed by netgen-upgrade. Mellanox mlx5 PMD needs unlimited
# locked memory to mlock NIC queue + flow-table memory; without
# LimitMEMLOCK=infinity, mlx5dv_dr_create_domain fails with
# 'Cannot allocate memory' and every DPDK stream dies at probe.
# v0.5.101 added these to the netgen-install systemd unit
# template (fresh installs); v0.5.102 drops them in via
# netgen-upgrade so wheel-upgraded servers get the same fix.
[Service]
LimitMEMLOCK=infinity
LimitNOFILE=1048576
LimitNPROC=infinity
"""


def _ensure_rlimits_dropin() -> None:
    """Idempotently install /etc/systemd/system/netgen-server.service.d/
    10-netgen-rlimits.conf with the Mellanox-required rlimits."""
    parent = RLIMITS_DROPIN_PATH.parent
    try:
        parent.mkdir(parents=True, exist_ok=True)
    except Exception as exc:
        logger.warning(
            f"[RLIMITS] could not create {parent}: {exc}. "
            f"Manually drop in LimitMEMLOCK=infinity if Mellanox "
            f"mlx5 PMD fails with 'Cannot allocate memory'."
        )
        return

    # Idempotent: only write if content differs.
    if RLIMITS_DROPIN_PATH.exists():
        try:
            if RLIMITS_DROPIN_PATH.read_text() == RLIMITS_DROPIN_CONTENT:
                logger.info(
                    f"[RLIMITS] ✓ {RLIMITS_DROPIN_PATH} already current"
                )
                return
        except Exception:
            pass  # fall through to overwrite

    try:
        RLIMITS_DROPIN_PATH.write_text(RLIMITS_DROPIN_CONTENT)
        # daemon-reload is implicit in the systemctl restart that
        # follows, but be explicit so the rlimits are picked up
        # even if a subsequent change races the restart.
        _run(["systemctl", "daemon-reload"], check=False)
        logger.info(
            f"[RLIMITS] ✓ Wrote {RLIMITS_DROPIN_PATH}"
            f" (Mellanox mlx5 PMD MEMLOCK fix)"
        )
    except Exception as exc:
        logger.warning(
            f"[RLIMITS] could not write {RLIMITS_DROPIN_PATH}: "
            f"{exc}. Manually drop in LimitMEMLOCK=infinity if "
            f"Mellanox mlx5 PMD fails."
        )


def _rebuild_tx_worker(install_root: Path, venv_py: Path) -> None:
    """Rebuild tx_worker.c against the locally-installed DPDK.

    Calls into install_dpdk.sh's dpdk_tx_worker.sh helper if
    available, otherwise falls back to a direct meson invoke.
    On success installs the freshly-built binary to
    /usr/local/bin/tx_worker (the canonical resolver path —
    see utils/dpdk_tx_worker.py:_resolve_tx_worker_bin).
    """
    # Find the wheel-extracted tx_worker source. After pip
    # install the resources/ tree is under
    # <venv>/lib/python3.X/site-packages/resources/dpdk/tx_worker.
    #
    # v0.5.101 bug (fixed here in v0.5.102): we imported
    # `resources.dpdk.tx_worker` as a Python package, but it's
    # not — the tx_worker subdir has no __init__.py, it's a data
    # subdir under the `resources.dpdk` package. The import
    # raised ModuleNotFoundError, _rebuild_tx_worker silently
    # returned, and srv06's binary stayed stale. Operator hit
    # `unrecognized option '--tx-cores'` on every stream launch
    # post-v0.5.101-upgrade.
    #
    # Fix: locate the `resources.dpdk` package directory (which
    # IS importable), then join the `tx_worker` subdir and
    # sanity-check tx_worker.c + meson.build are present.
    try:
        rc = subprocess.run(
            [str(venv_py), "-c",
             "import resources.dpdk, os; "
             "print(os.path.dirname(resources.dpdk.__file__))"],
            capture_output=True, text=True, timeout=10,
        )
        if rc.returncode != 0 or not rc.stdout.strip():
            logger.warning(
                "[TX_WORKER] could not locate resources.dpdk package "
                "in the venv; skipping rebuild. If DPDK streams fail "
                "with 'unrecognized option' errors, re-run "
                "install_dpdk.sh manually."
            )
            return
        src_dir = Path(rc.stdout.strip()) / "tx_worker"
        if not (src_dir / "tx_worker.c").exists():
            logger.warning(
                f"[TX_WORKER] {src_dir}/tx_worker.c not found — the "
                f"wheel may not have shipped the source. Skipping "
                f"rebuild. Re-run install_dpdk.sh from a fresh "
                f"tarball install to recover."
            )
            return
        if not (src_dir / "meson.build").exists():
            logger.warning(
                f"[TX_WORKER] {src_dir}/meson.build not found; "
                f"skipping rebuild. Re-run install_dpdk.sh manually."
            )
            return
        logger.info(f"[TX_WORKER] source located at {src_dir}")
    except Exception as exc:
        logger.warning(
            f"[TX_WORKER] source lookup failed: {exc}; skipping rebuild"
        )
        return

    # Build deps check — if libdpdk-dev / meson / ninja isn't
    # there, skip with a clear message rather than erroring out
    # the upgrade.
    missing = []
    for tool in ("meson", "ninja"):
        if subprocess.run(["which", tool], capture_output=True).returncode != 0:
            missing.append(tool)
    if subprocess.run(
        ["pkg-config", "--exists", "libdpdk"],
        capture_output=True,
    ).returncode != 0:
        missing.append("libdpdk-dev (pkg-config)")
    if missing:
        logger.warning(
            f"[TX_WORKER] build deps missing: {', '.join(missing)}. "
            f"Skipping tx_worker rebuild — the binary at "
            f"/usr/local/bin/tx_worker may be stale. Run "
            f"`sudo bash {install_root}/resources/dpdk/install_dpdk.sh` "
            f"to install build deps + rebuild."
        )
        return

    build_dir = src_dir / "build"
    try:
        # Wipe stale build dir; meson setup is fast.
        if build_dir.exists():
            subprocess.run(
                ["rm", "-rf", str(build_dir)],
                check=True, timeout=10,
            )
        _run(["meson", "setup", str(build_dir), str(src_dir)],
             check=True)
        _run(["meson", "compile", "-C", str(build_dir)], check=True)
    except subprocess.CalledProcessError as exc:
        logger.warning(
            f"[TX_WORKER] rebuild failed: {exc}. "
            f"Binary at /usr/local/bin/tx_worker may be stale; "
            f"DPDK streams could fail. Re-run install_dpdk.sh "
            f"to recover."
        )
        return

    built = build_dir / "tx_worker"
    if not built.exists():
        logger.warning(
            f"[TX_WORKER] meson reported success but {built} is "
            f"missing. Skipping install."
        )
        return

    try:
        _run(["install", "-m755", str(built), "/usr/local/bin/tx_worker"],
             check=True)
        logger.info(
            "[TX_WORKER] ✓ Rebuilt and installed to /usr/local/bin/tx_worker"
        )
    except subprocess.CalledProcessError as exc:
        logger.warning(
            f"[TX_WORKER] install to /usr/local/bin/ failed: {exc}. "
            f"The freshly-built binary is at {built}; you can copy "
            f"it manually."
        )


def main() -> int:
    _setup_logging()
    _require_root()

    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0

    # First non-flag arg is the wheel path.
    wheel_path: str | None = None
    for a in argv:
        if a.startswith("--"):
            continue
        wheel_path = a
        break
    if not wheel_path:
        logger.error("No wheel path supplied. Usage: netgen-upgrade <wheel>")
        return 1
    wheel = Path(wheel_path).resolve()
    if not wheel.exists() or not wheel.is_file():
        logger.error(f"Wheel not found or not a file: {wheel}")
        return 1
    if not wheel.suffix == ".whl":
        logger.error(f"Not a wheel file (expected .whl extension): {wheel}")
        return 1

    install_root = _resolve_install_root(argv)
    venv_pip = install_root / "netgen-venv" / "bin" / "pip"
    venv_py = install_root / "netgen-venv" / "bin" / "python"
    if not venv_pip.exists():
        logger.error(
            f"Bundled venv pip not found at {venv_pip}. Is this a "
            f"v0.5.0 tarball install? Pre-v0.5.0 installs (system "
            f"pip) should use the legacy upgrade flow."
        )
        return 1

    logger.info(f"[STARTUP] Install root: {install_root}")
    logger.info(f"[STARTUP] Wheel:        {wheel}")

    # v0.5.103: self-update from the wheel BEFORE running the
    # main install logic.
    #
    # Operator-bite caught on srv06 (Jun 11 2026): v0.5.101 had
    # a broken _rebuild_tx_worker (silent ModuleNotFoundError).
    # v0.5.102 fixed it. But operators upgrading v0.5.101 →
    # v0.5.102 saw the binary stay stale anyway — because the
    # OLD (v0.5.101) netgen-upgrade ran the upgrade, and the
    # v0.5.49 self-heal that copies the new netgen-upgrade from
    # the wheel onto /opt/netgen-server/bin/ only fires at
    # server startup, AFTER the upgrade is already done.
    # Result: new logic doesn't take effect until the NEXT
    # upgrade.
    #
    # Fix: read the wheel's own copy of netgen-upgrade. If it
    # differs from us (this running script), overwrite ourselves
    # and re-exec with the same argv. The wheel's logic runs on
    # the FIRST upgrade attempt, not the second.
    if not any(a == "--no-self-update" for a in argv):
        _maybe_self_update_and_reexec(wheel, argv)

    # v0.5.45: dropped --force-reinstall in favour of --upgrade.
    # Pre-fix, every wheel upgrade uninstalled + reinstalled all
    # 67 transitive deps — the operator saw a 100+ line log of
    # `Successfully uninstalled X-Y.Z` followed by
    # `Successfully installed X-Y.Z` for ~65 packages that DIDN'T
    # change version. Just wasted time + disk churn + log noise.
    #
    # Real operator complaint (Jun 8 2026, v0.5.43 → v0.5.44):
    # "seems when upgrading the new version it uninstalls first
    #  then installs again.. pls check if this is necessary?"
    #
    # Actual changed-version packages on that upgrade: 2 of 67
    # (ostg-trafficgen + Flask-Cors).
    #
    # `pip install --upgrade <wheel>` with the default
    # `--upgrade-strategy=only-if-needed` does the right thing:
    # only touches packages whose installed version doesn't
    # satisfy the new constraint. Untouched deps keep their
    # existing site-packages entries.
    #
    # Why --force-reinstall was there originally (v0.4.8):
    # if an operator REBUILT a wheel with the same version
    # number (typical lab-dev workflow), pip would no-op because
    # the installed version matched. The fix made every install
    # re-fetch + replace. But operator-shipped upgrades always
    # bump the version, so the lab-dev case doesn't apply.
    #
    # For the rare "I rebuilt a same-version wheel" case the
    # operator can pass --force-reinstall as an explicit flag:
    #   sudo netgen-upgrade --force-reinstall my-rebuilt.whl
    force_reinstall = "--force-reinstall" in argv
    pip_cmd = [str(venv_pip), "install", "--no-cache-dir"]
    if force_reinstall:
        pip_cmd.append("--force-reinstall")
        logger.info("[INSTALL] --force-reinstall requested via CLI")
    else:
        pip_cmd.append("--upgrade")
    pip_cmd.append(str(wheel))
    try:
        _run(pip_cmd, check=True)
    except subprocess.CalledProcessError as exc:
        logger.error(f"pip install failed: {exc}")
        return 2

    # Post-install verify (mirrors v0.4.8 install_ostg sanity check):
    # core deps must still be importable from the venv. New wheels
    # SHOULDN'T introduce missing deps (we'd have caught that in
    # CI) but the check is cheap insurance.
    try:
        _run(
            [str(venv_py), "-c",
             "import flask, scapy.all, requests, psutil, run_tgen_server"],
            check=True, capture=True,
        )
        logger.info("[VERIFY] ✓ Imports still work post-upgrade")
    except subprocess.CalledProcessError as exc:
        logger.error(
            f"Post-upgrade import check failed:\n{exc.stderr or exc.stdout}"
        )
        logger.error(
            "The wheel installed but the venv is now broken. Roll "
            "back by reinstalling the previous wheel, or do a full "
            "tarball reinstall."
        )
        return 3

    # Operator-bite caught on srv06 (Jun 11 2026): the new
    # wheel's launcher (utils/dpdk_tx_worker.py) passes flags
    # like `--tx-cores N` that may not exist in the tx_worker
    # binary at /usr/local/bin/tx_worker, which was built when
    # the PREVIOUS wheel installed via install_dpdk.sh Step 6.
    # Result: every DPDK stream launch errors with
    #   /usr/local/bin/tx_worker: unrecognized option '--tx-cores'
    # AND every stream falls back to Scapy at ~10x slower.
    #
    # Rebuild tx_worker from the wheel-shipped source so the
    # binary always matches the launcher. Best-effort: if the
    # build deps aren't present (libdpdk-dev missing) we WARN
    # and continue; the launcher can still run Scapy streams.
    _rebuild_tx_worker(install_root, venv_py)

    # v0.5.102: drop in the Mellanox rlimits conf for already-
    # installed servers. v0.5.101 added LimitMEMLOCK=infinity
    # etc. to the netgen-install systemd unit template, but
    # netgen-upgrade only does pip install — it never rewrites
    # /etc/systemd/system/netgen-server.service. Operators
    # upgrading from <v0.5.101 wheels would never pick up the
    # Mellanox fix and hit the same mlx5dv_dr_create_domain
    # failure that motivated v0.5.101. A drop-in conf is safer
    # than rewriting the unit (preserves operator customizations
    # of the main file) and idempotent (re-running creates
    # identical content).
    _ensure_rlimits_dropin()

    # Restart the unit so the new code is loaded.
    _run(["systemctl", "restart", SYSTEMD_UNIT_NAME], check=True)

    if _verify_new_version():
        logger.info("=" * 60)
        logger.info("netgen-server upgrade complete.")
        logger.info("=" * 60)
        return 0
    return 1


if __name__ == "__main__":
    sys.exit(main())
